# =============================================================================
# Trodplas — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# NEVER commit .env.local. Only this .env.example (with placeholders) is committed.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser — put ONLY
# non-secret, publishable values there. Everything else stays server-side.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# The canonical URL of the app. Used to build Stripe redirect/return URLs and
# email links. Use http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase  (Dashboard → Project Settings → API)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" public key — safe to expose to the browser. RLS protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" secret key — FULL ADMIN ACCESS, bypasses RLS.
# SERVER-ONLY. Used by the seed script and trusted server actions/webhooks.
# Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe  (Dashboard → Developers → API keys)  — use TEST mode keys in dev
# -----------------------------------------------------------------------------
# Publishable key (pk_test_...) — safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret key (sk_test_...) — SERVER-ONLY.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...). For local dev, the Stripe CLI prints this
# when you run `stripe listen`. In production, copy it from the webhook endpoint
# you create in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Platform commission taken on each booking, in basis points of 10000.
# 2000 = 20%. The lender's connected account receives the remainder.
PLATFORM_FEE_BPS=2000

# -----------------------------------------------------------------------------
# Resend  (https://resend.com → API Keys)
# -----------------------------------------------------------------------------
# Secret API key (re_...). SERVER-ONLY.
RESEND_API_KEY=

# The verified "from" address for transactional email.
# In dev you can use onboarding@resend.dev without verifying a domain.
RESEND_FROM_EMAIL="Trodplas <onboarding@resend.dev>"
